# Supabase project settings (Project Settings -> API)
# Copy this file to .env.local and fill in your values.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The email of the single shared account you create in Supabase Auth.
# The family "PIN" is that account's PASSWORD (min 6 characters).
VITE_AUTH_EMAIL=family@yourhome.app
